# Claude models (the agent's workers)
ANTHROPIC_API_KEY=sk-ant-...

# Which System One backend answers the routing question.
#   gateway : Vercel AI Gateway POST /v1/evaluate (hosted; Laya is free there through 2026-10-31)
#   server  : any Jev-compatible POST /v1/systemone server, e.g. `pip install "laya[serve]" && laya-serve`
#   local   : the `laya` package in-process (pip install "systemone-router[local]")
SYSTEMONE_BACKEND=gateway

# gateway backend
AI_GATEWAY_API_KEY=vck_...
SYSTEMONE_MODEL=convaiinnovations/laya
# AI_GATEWAY_EVALUATE_URL=https://ai-gateway.vercel.sh/v1/evaluate

# server backend
# SYSTEMONE_SERVER_URL=http://localhost:8000
# SYSTEMONE_API_KEY=            # only if the server sets LAYA_API_KEY
